class Solution {
    public int[][] matrixReshape(int[][] mat, int r, int c) {
        int temp=c;
        if(r*c!=mat.length*mat[0].length){
            return mat;
        }
        int[][] ans=new int[r][c];
        ArrayList<Integer> arr=new ArrayList<>();
        for(int[] i:mat){
            for(int j:i){
                arr.add(j);
            }
        }
        int count=0;
        for(int i=0;i<r;i++){
            for(int j=0;j<c;j++){
                ans[i][j]=arr.get(count);
                count++;
            }
        }
        return ans;
    }
}
