class Solution {
    public int[] getConcatenation(int[] nums) {
        int[] ans=new int[2*nums.length];
        int count=0;
        for(int i:nums){
            ans[count]=i;
            count++;
        }
        for(int i:nums){
            ans[count]=i;
            count++;
        }
        return ans;
    }
}
