class Solution {
    public int longestConsecutive(int[] nums) {
        if(nums.length==0){
            return 0;
        }
        Arrays.sort(nums);
        int count=1;
        int maxs=0;
        int ele=nums[0];
        for(int i=1;i<nums.length;i++){
            if(nums[i]==ele){
                ele=ele;
            }
            else if(nums[i]==ele+1){
                ele=nums[i];
                count=count+1;

            }
            else{
                maxs=Math.max(count,maxs);
                count=1;
                ele=nums[i];
            }
        }
        maxs=Math.max(count,maxs);
        return maxs;

    }
}
