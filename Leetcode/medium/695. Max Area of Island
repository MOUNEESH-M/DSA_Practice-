class Solution {
    public int maxAreaOfIsland(int[][] grid) {
        Queue<int[]> q=new LinkedList<>();
        int mc=0;
        for(int i=0;i<grid.length;i++){
            for(int j=0;j<grid[0].length;j++){
                if(grid[i][j]!=-1 && grid[i][j]==1){
                    int count=0;
                    q.offer(new int[]{i,j});
                    while(!q.isEmpty()){
                        count++;
                        int[] curr=q.poll();
                        int st=curr[0];
                        int end=curr[1];
                        grid[st][end]=-1;
                        if(st-1>=0&&grid[st-1][end]==1){
                            q.offer(new int[]{st-1,end});
                            grid[st-1][end]=-1;
                        }
                        if(st+1<grid.length && grid[st+1][end]==1 && grid[st+1][end]!=-1){
                            q.offer(new int[]{st+1,end});
                            grid[st+1][end]=-1;
                        }
                        if(end-1>=0&&grid[st][end-1]==1&&grid[st][end-1]!=-1){
                            q.offer(new int[]{st,end-1});
                            grid[st][end-1]=-1;
                        }
                        if(end+1<grid[0].length&&grid[st][end+1]==1&&grid[st][end+1]!=-1){
                            q.offer(new int[]{st,end+1});
                            grid[st][end+1]=-1;
                        }
                        System.out.println(st+" "+end+" "+count);
                    }
                    mc=Math.max(mc,count);
                }
            }
            
        }
        return mc;
    }
}
