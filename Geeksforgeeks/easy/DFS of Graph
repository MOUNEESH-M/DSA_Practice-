class Solution {
    public ArrayList<Integer> dfs(ArrayList<ArrayList<Integer>> adj) {
        // code here
        ArrayList<Integer> ans=new ArrayList<>();
        int[] vis=new int[adj.size()];
        ans.add(0);
        vis[0]=1;
        helper(adj,ans,vis,0);
        return ans;
    }
    public void helper(ArrayList<ArrayList<Integer>> adj,ArrayList<Integer> ans,int[] vis,int j){
        for(Integer i : adj.get(j)){
            if(vis[i]!=1){
                ans.add(i);
                vis[i]=1;
                helper(adj,ans,vis,i);
            }
        }
        return;
    }
}
