class Solution {
    public ArrayList<Integer> bfs(ArrayList<ArrayList<Integer>> adj) {
        ArrayList<Integer> arr=new ArrayList<>();
        Queue<Integer> q=new LinkedList<>();
        int[] vis=new int[adj.size()];
        q.offer(0);
        vis[0]=1;
        arr.add(0);
        while(!q.isEmpty()){
            Integer curr=q.poll();
            for(Integer i : adj.get(curr)){
                if(vis[i]!=1){
                    arr.add(i);
                    vis[i]=1;
                    q.offer(i);
                }
            }
        }
        return arr;
    }
}
